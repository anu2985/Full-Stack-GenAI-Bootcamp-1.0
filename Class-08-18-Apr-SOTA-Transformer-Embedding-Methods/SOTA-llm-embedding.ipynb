   "source": [
    "## Semantic Search (Similarity Search)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "e237ed95",
   "metadata": {},
   "source": [
    "1. Dot Product\n",
    "2. Cosine Sim\n",
    "3. Eculidean Distance(L2)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "6c887807",
   "metadata": {},
   "source": []
  },
  {
   "cell_type": "code",
   "execution_count": 49,
   "id": "22e921b3",
   "metadata": {},
   "outputs": [],
   "source": [
    "def dot_product(a, b):\n",
    "    return np.dot(a, b)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 50,
   "id": "9473ace2",
   "metadata": {},
   "outputs": [],
   "source": [
    "def cosine_similarity(a, b):\n",
    "    return np.dot(a, b) / (np.linalg.norm(a) * np.linalg.norm(b))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 51,
   "id": "807c495a",
   "metadata": {},
   "outputs": [],
   "source": [
    "def euclidean_distance(a, b):\n",
    "    a = np.array(a)\n",
    "    b = np.array(b)\n",
    "    return np.linalg.norm(a - b)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 58,
   "id": "38447fbc",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "=== Cosine Similarity (Higher is better) ===\n",
      "Range: -1 to 1\n",
      "\n",
      "=== Dot Product (Higher is better) ===\n",
      "Range: -∞ to +∞ (depends on vector magnitude)\n",
      "\n",
      "=== Euclidean Distance (Lower is better) ===\n",
      "Range: 0 to +∞\n"
     ]
    }
   ],
   "source": [
    "print(\"=== Cosine Similarity (Higher is better) ===\")\n",
